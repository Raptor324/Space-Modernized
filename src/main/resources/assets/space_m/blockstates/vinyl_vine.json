{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "space_m:block/vinyl_vine"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "space_m:block/vinyl_vine",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "space_m:block/vinyl_vine",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "space_m:block/vinyl_vine",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "space_m:block/vinyl_vine",
        "x": 270
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "false",
            "east": "false",
            "south": "false",
            "west": "false",
            "up": "false"
          }
        ]
      },
      "apply": {
        "model": "space_m:block/vinyl_vine"
      }
    }
  ]
}
